#include <windows.h>
#include "src/version.h"

IDI_ICON1 ICON "app.ico"

1 24 "app.manifest"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     APP_VERSION_RC
PRODUCTVERSION  APP_VERSION_RC
FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
#ifdef _DEBUG
FILEFLAGS       VS_FF_DEBUG
#else
FILEFLAGS       0x0L
#endif
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      APP_COMPANY "\0"
            VALUE "FileDescription",  APP_DESCRIPTION "\0"
            VALUE "FileVersion",      APP_VERSION_RC_STR "\0"
            VALUE "InternalName",     APP_INTERNAL_NAME "\0"
            VALUE "LegalCopyright",   APP_COPYRIGHT_RC "\0"
            VALUE "OriginalFilename", APP_ORIGINAL_NAME "\0"
            VALUE "ProductName",      APP_NAME "\0"
            VALUE "ProductVersion",   APP_VERSION_RC_STR "\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
