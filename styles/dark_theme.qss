/* =========================================================================
   RAM CLEANER & FLUSHER PRO - MICROSOFT WINDOWS 11 DARK THEME
   Designed for: AliSakkaf (https://github.com/alisakkaf)
   ========================================================================= */

/* --- GLOBAL CORE SETTINGS --- */
QWidget {
    font-family: "Segoe UI";
    font-size: 9pt;
    color: #ffffff;
    background-color: transparent;
    outline: none;
}

QMainWindow, QDialog, QMessageBox {
    background-color: #202020;
}

/* Specific Labels */
#lblHeaderTitle, #lblRamLoadVal, #lblAppBanner {
    font-size: 15pt;
    color: #ffffff;
}

#lblStandbyVal {
    font-size: 10pt;
    color: #cccccc;
}

#lblGroupSummary {
    font-size: 9.5pt;
    color: #cbd5e1;
    font-weight: 500;
}

/* --- TAB WIDGET & BAR --- */
QTabWidget::pane {
    border: 1px solid #333333;
    background-color: #272727;
    border-radius: 8px;
    top: -1px;
}

QTabBar::tab {
    background-color: transparent;
    color: #a0a0a0;
    padding: 7px 16px;
    margin-right: 4px;
    border-radius: 6px;
    border: 1px solid transparent;
}

QTabBar::tab:hover {
    background-color: #2c2c2c;
    color: #ffffff;
}

QTabBar::tab:selected {
    background-color: #2c2c2c;
    color: #ffffff;
    border-bottom: 3px solid #0078d4;
    font-weight: bold;
}

QTabBar::scroller {
    width: 24px;
}

QTabBar QToolButton {
    background-color: #2c2c2c;
    border: 1px solid #383838;
    border-radius: 4px;
    color: #ffffff;
}

/* --- GROUP BOXES (Windows 11 Fluent Cards) --- */
QGroupBox {
    border: 1px solid #333333;
    border-radius: 8px;
    margin-top: 14px;
    padding: 10px 14px;
    background-color: #272727;
    font-weight: 600;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 10px;
    top: 2px;
    padding: 0 4px;
    background-color: transparent;
    color: #38bdf8;
}

/* --- BUTTONS --- */
QPushButton {
    background-color: #2d2d2d;
    color: #ffffff;
    border: 1px solid #383838;
    border-bottom: 1px solid #1f1f1f;
    border-radius: 5px;
    padding: 6px 14px;
    font-weight: 500;
}

QPushButton:hover {
    background-color: #383838;
    border-color: #454545;
}

QPushButton:pressed {
    background-color: #242424;
    color: #cccccc;
}

QPushButton:disabled {
    background-color: #1a1a1a;
    color: #555555;
    border-color: #222222;
}

/* OLD Primary Accent Buttons */
btnMaxOpt, btnQuickOpt, btnLaunchBoostedApp {
    background-color: #0078d4;
    border: 1px solid #0078d4;
    color: #ffffff;
    font-weight: 600;
}

btnMaxOpt:hover, btnQuickOpt:hover, btnLaunchBoostedApp:hover {
    background-color: #106ebe;
    border-color: #106ebe;
}


/* Action Box Buttons inside Table / Tree Rows (⋮) */
#btnRowAction {
    background-color: rgba(56, 189, 248, 0.12);
    border: 1px solid #38bdf8;
    border-radius: 4px;
    color: #38bdf8;
    font-size: 13pt;
    font-weight: bold;
    padding: 0px;
    margin: 0px;
}

#btnRowAction:hover {
    background-color: #38bdf8;
    color: #202020;
    border-color: #38bdf8;
}

#btnToggleTheme {
    background-color: #2d2d2d;
    border: 1px solid #383838;
    border-radius: 5px;
    padding: 5px 14px;
    font-weight: bold;

}

#btnToggleTheme:hover {
    background-color: #383838;
}

#btnGithub, #btnFacebook, #btnWebsite {
    background-color: #272727;
    border: 1px solid #383838;
    border-radius: 8px;
    padding: 10px 18px;
    color: #ffffff;
}

#btnGithub:hover, #btnFacebook:hover, #btnWebsite:hover {
    background-color: #323232;
    border-color: #0078d4;
}

/* --- DYNAMIC RAM PROGRESS BAR --- */
QProgressBar {
    border: 1px solid #333333;
    border-radius: 6px;
    text-align: center;
    color: #ffffff;
    font-weight: bold;
    background-color: #1f1f1f;
    min-height: 22px;
    max-height: 22px;
}

QProgressBar::chunk {
    background-color: qlineargradient(
        x1: 0, y1: 0, x2: 1, y2: 0,
        stop: 0.0 #10b981,
        stop: 0.5 #f59e0b,
        stop: 1.0 #ef4444
    );
    border-radius: 5px;
}

/* --- INPUT FIELDS & SPIN BOXES --- */
QLineEdit, QTextEdit, QPlainTextEdit, QSpinBox, QDoubleSpinBox {
    background-color: #1f1f1f;
    border: 1px solid #383838;
    border-bottom: 2px solid #888888;
    border-radius: 4px;
    color: #ffffff;
    padding: 5px 10px;
    selection-background-color: #0078d4;
    selection-color: #ffffff;
}

QLineEdit:hover, QTextEdit:hover, QSpinBox:hover {
    background-color: #252525;
    border-bottom-color: #cccccc;
}

QLineEdit:focus, QTextEdit:focus, QSpinBox:focus {
    background-color: #1f1f1f;
    border-bottom: 2px solid #0078d4;
}

#txtLog {
    background-color: #181818;
    border: 1px solid #2f2f2f;
    border-radius: 6px;
    font-size: 9.5pt;
    color: #e2e8f0;
    font-weight: bold;
}

/* SpinBox Buttons */
QSpinBox::up-button, QSpinBox::down-button {
    background-color: transparent;
    width: 16px;
    border: none;
}

QSpinBox::up-button:hover, QSpinBox::down-button:hover {
    background-color: #383838;
}

/* --- COMBO BOX --- */
QComboBox {
    background-color: #2d2d2d;
    border: 1px solid #383838;
    border-radius: 4px;
    color: #ffffff;
    padding: 5px 12px;
}

QComboBox:hover {
    background-color: #383838;
}

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 20px;
    border: none;
}

QComboBox QAbstractItemView {
    background-color: #272727;
    color: #ffffff;
    border: 1px solid #383838;
    border-radius: 6px;
    padding: 4px;
    selection-background-color: #0078d4;
    selection-color: #ffffff;
    outline: none;
}

/* --- CHECKBOX & CHECKMARK ICON --- */
QCheckBox, QRadioButton {
    spacing: 8px;
    color: #ffffff;
}

QCheckBox::indicator, QRadioButton::indicator {
    width: 18px;
    height: 18px;
    border: 1px solid #666666;
    background-color: #2d2d2d;
}

QCheckBox::indicator { border-radius: 4px; }
QRadioButton::indicator { border-radius: 9px; }

QCheckBox::indicator:hover, QRadioButton::indicator:hover {
    border-color: #0078d4;
}

QCheckBox::indicator:checked {
    background-color: #0078d4;
    border-color: #0078d4;
    image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='14' height='14' viewBox='0 0 24 24' fill='none' stroke='white' stroke-width='3.5' stroke-linecap='round' stroke-linejoin='round'><polyline points='20 6 9 17 4 12'></polyline></svg>");
}

QRadioButton::indicator:checked {
    background-color: #0078d4;
    border-color: #0078d4;
}

/* --- TABLES, TREES & LISTS --- */
QTableWidget, QTableView, QTreeWidget, QTreeView, QListWidget {
    background-color: #272727;
    gridline-color: #2f2f2f;
    border: 1px solid #2f2f2f;
    border-radius: 6px;
    alternate-background-color: #202020;
    color: #ffffff;
}

QHeaderView::section {
    background-color: #202020;
    color: #cccccc;
    padding: 8px;
    border: none;
    border-right: 1px solid #2f2f2f;
    border-bottom: 1px solid #2f2f2f;
    font-weight: 600;
}

QHeaderView::section:hover {
    background-color: #282828;
    color: #ffffff;
}

QTreeWidget::item, QListWidget::item, QTableWidget::item {
    padding: 6px;
    border-radius: 4px;
}

QTreeWidget::item:hover, QListWidget::item:hover, QTableWidget::item:hover {
    background-color: #323232;
}

QTreeWidget::item:selected, QListWidget::item:selected, QTableWidget::item:selected {
    background-color: #0078d4;
    color: #ffffff;
}

/* --- SCROLLBARS --- */
QScrollBar:vertical {
    border: none;
    background: transparent;
    width: 10px;
    margin: 0px;
}

QScrollBar::handle:vertical {
    background: #454545;
    min-height: 24px;
    border-radius: 5px;
    margin: 2px;
}

QScrollBar::handle:vertical:hover { background: #0078d4; }

QScrollBar:horizontal {
    border: none;
    background: transparent;
    height: 10px;
    margin: 0px;
}

QScrollBar::handle:horizontal {
    background: #454545;
    min-width: 24px;
    border-radius: 5px;
    margin: 2px;
}

QScrollBar::handle:horizontal:hover { background: #0078d4; }

/* --- MENUS & TOOLTIPS --- */
QMenu {
    background-color: #2c2c2c;
    color: #ffffff;
    border: 1px solid #383838;
    border-radius: 8px;
    padding: 6px;
}

QMenu::item { padding: 6px 24px; border-radius: 4px; }
QMenu::item:selected { background-color: #0078d4; color: #ffffff; }

QToolTip {
    background-color: #2c2c2c;
    color: #ffffff;
    border: 1px solid #383838;
    border-radius: 4px;
    padding: 6px;
}

/* --- QSPINBOX (SILVER ELEGANT DARK THEME) --- */
QSpinBox, QDoubleSpinBox {
    background-color: #1f1f1f;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-bottom: 2px solid #666666;
    border-radius: 5px;
    color: #ffffff;
    padding: 5px 28px 5px 10px;
    selection-background-color: #333333;
    selection-color: #ffffff;
}

QSpinBox:hover, QDoubleSpinBox:hover {
    background-color: #252525;
    border-bottom-color: #cccccc;
}

QSpinBox:focus, QDoubleSpinBox:focus {
    background-color: #1f1f1f;
    border-bottom: 2px solid #60cdff;
}

QSpinBox::up-button, QDoubleSpinBox::up-button {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 20px;
    height: 11px;
    background-color: rgba(255, 255, 255, 0.06);
    border-top-right-radius: 4px;
    border: none;
    margin-right: 2px;
    margin-top: 2px;
}

QSpinBox::down-button, QDoubleSpinBox::down-button {
    subcontrol-origin: padding;
    subcontrol-position: bottom right;
    width: 20px;
    height: 11px;
    background-color: rgba(255, 255, 255, 0.06);
    border-bottom-right-radius: 4px;
    border: none;
    margin-right: 2px;
    margin-bottom: 2px;
}

QSpinBox::up-button:hover, QDoubleSpinBox::up-button:hover,
QSpinBox::down-button:hover, QDoubleSpinBox::down-button:hover {
    background-color: rgba(255, 255, 255, 0.15);
}

QSpinBox::up-button:pressed, QDoubleSpinBox::up-button:pressed,
QSpinBox::down-button:pressed, QDoubleSpinBox::down-button:pressed {
    background-color: rgba(255, 255, 255, 0.25);
}

QSpinBox::up-arrow, QDoubleSpinBox::up-arrow {
    width: 0px;
    height: 0px;
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    border-bottom: 5px solid #cbd5e1;
}

QSpinBox::down-arrow, QDoubleSpinBox::down-arrow {
    width: 0px;
    height: 0px;
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    border-top: 5px solid #cbd5e1;
}

QSpinBox::up-button:hover QSpinBox::up-arrow,
QDoubleSpinBox::up-button:hover QDoubleSpinBox::up-arrow,
QSpinBox::down-button:hover QSpinBox::down-arrow,
QDoubleSpinBox::down-button:hover QDoubleSpinBox::down-arrow {
    border-bottom-color: #ffffff;
    border-top-color: #ffffff;
}

/* =========================================================================
   QLABEL STYLES - WINDOWS 11 FLUENT DARK THEME
   ========================================================================= */

QLabel {
    color: #ffffff;
    font-family: "Segoe UI";
    font-size: 9.5pt;
    background-color: transparent;
    border: none;
    padding: 0px;
    margin: 0px;
}

QLabel:disabled {
    color: #787878;
}

#lblHeaderTitle, #lblRamLoadVal, #lblAppBanner {
    font-size: 16pt;
    font-weight: bold;
    color: #ffffff;
}

#lblStandbyVal {
    font-size: 10pt;
    color: #cccccc;
}

QLabel[heading="true"] {
    font-size: 12pt;
    font-weight: bold;
    color: #ffffff;
}

QLabel[subtitle="true"] {
    font-size: 9pt;
    color: #a0a0a0;
}

QLabel[accent="true"] {
    color: #60cdff;
    font-weight: bold;
}

QLabel[status="success"] {
    color: #6ccb5f;
    font-weight: bold;
}

QLabel[status="warning"] {
    color: #fce100;
    font-weight: bold;
}

QLabel[status="error"] {
    color: #ff99a4;
    font-weight: bold;
}

QLabel[badge="true"] {
    background-color: #2c2c2c;
    color: #60cdff;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 4px;
    padding: 2px 8px;
    font-size: 8.5pt;
    font-weight: bold;
}

QLabel[interactive="true"]:hover {
    color: #60cdff;
}
