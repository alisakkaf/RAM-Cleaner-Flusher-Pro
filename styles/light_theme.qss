/* =========================================================================
   RAM CLEANER & FLUSHER PRO - MICROSOFT WINDOWS 11 LIGHT THEME
   Designed for: AliSakkaf (https://github.com/alisakkaf)
   ========================================================================= */

/* --- GLOBAL CORE SETTINGS --- */
QWidget {
    font-family: "Segoe UI";
    font-size: 9pt;
    color: #ffffff;
    background-color: transparent;
    outline: none;
}

QMainWindow, QDialog, QMessageBox {
    background-color: #f3f3f3;
}

/* Specific Labels */
#lblHeaderTitle, #lblRamLoadVal, #lblAppBanner {
    font-size: 15pt;
    color: #0f172a;
}

#lblStandbyVal {
    font-size: 10pt;
    color: #475569;
}

#lblGroupSummary {
    font-size: 9.5pt;
    color: #475569;
    font-weight: 500;
}

/* --- TAB WIDGET & BAR --- */
QTabWidget::pane {
    border: 1px solid #e5e5e5;
    background-color: #ffffff;
    border-radius: 8px;
    top: -1px;
}

QTabBar::tab {
    background-color: transparent;
    color: #555555;
    padding: 7px 16px;
    margin-right: 4px;
    border-radius: 6px;
    border: 1px solid transparent;
}

QTabBar::tab:hover {
    background-color: #eaeaea;
    color: #1a1a1a;
}

QTabBar::tab:selected {
    background-color: #ffffff;
    color: #0078d4;
    border-bottom: 3px solid #0078d4;
    font-weight: bold;
}

QTabBar::scroller {
    width: 24px;
}

QTabBar QToolButton {
    background-color: #f0f0f0;
    border: 1px solid #d1d1d1;
    border-radius: 4px;
    color: #1a1a1a;
}

/* --- GROUP BOXES (Windows 11 Fluent Cards) --- */
QGroupBox {
    border: 1px solid #e5e5e5;
    border-radius: 8px;
    margin-top: 14px;
    padding: 10px 14px;
    background-color: #ffffff;
    font-weight: 600;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 10px;
    top: 2px;
    padding: 0 4px;
    background-color: transparent;
    color: #0078d4;
}

/* --- BUTTONS --- */
QPushButton {
    background-color: #fbfbfb;
    color: #1a1a1a;
    border: 1px solid #d1d1d1;
    border-bottom: 1px solid #b5b5b5;
    border-radius: 5px;
    padding: 6px 14px;
    font-weight: 500;
}

QPushButton:hover {
    background-color: #f0f0f0;
    border-color: #c7c7c7;
}

QPushButton:pressed {
    background-color: #e5e5e5;
    color: #333333;
}

QPushButton:disabled {
    background-color: #f5f5f5;
    color: #a0a0a0;
    border-color: #e0e0e0;
}

/* OLD Primary Accent Buttons */
btnMaxOpt, btnQuickOpt, btnLaunchBoostedApp {
    background-color: #0078d4;
    border: 1px solid #0078d4;
    color: #ffffff;
    font-weight: 600;
}

btnMaxOpt:hover, btnQuickOpt:hover, btnLaunchBoostedApp:hover {
    background-color: #106ebe;
    border-color: #106ebe;
}

#btnMaxOpt:hover, #btnQuickOpt:hover, #btnLaunchBoostedApp:hover {
    background-color: #e2e8f0;
    border-color: #cbd5e1;
    color: #0f172a;
}

#btnMaxOpt:pressed, #btnQuickOpt:pressed, #btnLaunchBoostedApp:pressed {
    background-color: #cbd5e1;
    border-color: #94a3b8;
    color: #020617;
}

/* Action Box Buttons inside Table / Tree Rows (⋮) */
#btnRowAction {
    background-color: rgba(2, 132, 199, 0.08);
    border: 1px solid #0284c7;
    border-radius: 4px;
    color: #0284c7;
    font-size: 13pt;
    font-weight: bold;
    padding: 0px;
    margin: 0px;
}

#btnRowAction:hover {
    background-color: #0284c7;
    color: #ffffff;
    border-color: #0284c7;
}

#btnToggleTheme {
    background-color: #fbfbfb;
    border: 1px solid #d1d1d1;
    border-radius: 5px;
    padding: 5px 14px;
    font-weight: bold;

}

#btnToggleTheme:hover {
    background-color: #f0f0f0;
}

#btnGithub, #btnFacebook, #btnWebsite {
    background-color: #ffffff;
    border: 1px solid #e5e5e5;
    border-radius: 8px;
    padding: 10px 18px;
    color: #1a1a1a;
}

#btnGithub:hover, #btnFacebook:hover, #btnWebsite:hover {
    background-color: #f8fafc;
    border-color: #0078d4;
}

/* --- DYNAMIC RAM PROGRESS BAR --- */
QProgressBar {
    border: 1px solid #e5e5e5;
    border-radius: 6px;
    text-align: center;
    color: #1a1a1a;
    font-weight: bold;
    background-color: #f3f3f3;
    min-height: 22px;
    max-height: 22px;
}

QProgressBar::chunk {
    background-color: qlineargradient(
        x1: 0, y1: 0, x2: 1, y2: 0,
        stop: 0.0 #107c41,
        stop: 0.5 #fce100,
        stop: 0.8 #ff8c00,
        stop: 1.0 #e81123
    );
    border-radius: 5px;
}

/* --- INPUT FIELDS & SPIN BOXES --- */
QLineEdit, QTextEdit, QPlainTextEdit, QDoubleSpinBox {
    background-color: #ffffff;
    border: 1px solid #d1d1d1;
    border-bottom: 2px solid #888888;
    border-radius: 4px;
    color: #1a1a1a;
    padding: 5px 10px;
    selection-background-color: #0078d4;
    selection-color: #ffffff;
}

QLineEdit:hover, QTextEdit:hover {
    background-color: #fcfcfc;
    border-bottom-color: #555555;
}

QLineEdit:focus, QTextEdit:focus {
    background-color: #ffffff;
    border-bottom: 2px solid #0078d4;
}

#txtLog {
    background-color: #ffffff;
    border: 1px solid #e5e5e5;
    border-radius: 6px;
    font-family: "Consolas", monospace;
    font-size: 9.5pt;
    color: #0f172a;
}



/* --- COMBO BOX --- */
QComboBox {
    background-color: #ffffff;
    border: 1px solid #d1d1d1;
    border-radius: 4px;
    color: #1a1a1a;
    padding: 5px 12px;
}

QComboBox:hover {
    background-color: #f0f0f0;
}

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 20px;
    border: none;
}

QComboBox QAbstractItemView {
    background-color: #ffffff;
    color: #1a1a1a;
    border: 1px solid #d1d1d1;
    border-radius: 6px;
    padding: 4px;
    selection-background-color: #0078d4;
    selection-color: #ffffff;
    outline: none;
}

/* --- CHECKBOX & CHECKMARK ICON --- */
QCheckBox, QRadioButton {
    spacing: 8px;
    color: #1a1a1a;
}

QCheckBox::indicator, QRadioButton::indicator {
    width: 18px;
    height: 18px;
    border: 1px solid #888888;
    background-color: #ffffff;
}

QCheckBox::indicator { border-radius: 4px; }
QRadioButton::indicator { border-radius: 9px; }

QCheckBox::indicator:hover, QRadioButton::indicator:hover {
    border-color: #0078d4;
}

QCheckBox::indicator:checked {
    background-color: #0078d4;
    border-color: #0078d4;
    image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='14' height='14' viewBox='0 0 24 24' fill='none' stroke='white' stroke-width='3.5' stroke-linecap='round' stroke-linejoin='round'><polyline points='20 6 9 17 4 12'></polyline></svg>");
}

QRadioButton::indicator:checked {
    background-color: #0078d4;
    border-color: #0078d4;
}

/* --- TABLES, TREES & LISTS --- */
QTableWidget, QTableView, QTreeWidget, QTreeView, QListWidget {
    background-color: #ffffff;
    gridline-color: #e5e5e5;
    border: 1px solid #e5e5e5;
    border-radius: 6px;
    alternate-background-color: #f9f9f9;
    color: #1a1a1a;
}

QHeaderView::section {
    background-color: #f9f9f9;
    color: #333333;
    padding: 8px;
    border: none;
    border-right: 1px solid #e5e5e5;
    border-bottom: 1px solid #e5e5e5;
    font-weight: 600;
}

QHeaderView::section:hover {
    background-color: #f0f0f0;
    color: #000000;
}

QTreeWidget::item, QListWidget::item, QTableWidget::item {
    padding: 6px;
    border-radius: 4px;
}

QTreeWidget::item:hover, QListWidget::item:hover, QTableWidget::item:hover {
    background-color: #f0f0f0;
}

QTreeWidget::item:selected, QListWidget::item:selected, QTableWidget::item:selected {
    background-color: #0078d4;
    color: #ffffff;
}

/* --- SCROLLBARS --- */
QScrollBar:vertical {
    border: none;
    background: transparent;
    width: 10px;
    margin: 0px;
}

QScrollBar::handle:vertical {
    background: #cccccc;
    min-height: 24px;
    border-radius: 5px;
    margin: 2px;
}

QScrollBar::handle:vertical:hover { background: #0078d4; }

QScrollBar:horizontal {
    border: none;
    background: transparent;
    height: 10px;
    margin: 0px;
}

QScrollBar::handle:horizontal {
    background: #cccccc;
    min-width: 24px;
    border-radius: 5px;
    margin: 2px;
}

QScrollBar::handle:horizontal:hover { background: #0078d4; }

/* --- MENUS & TOOLTIPS --- */
QMenu {
    background-color: #ffffff;
    color: #1a1a1a;
    border: 1px solid #d1d1d1;
    border-radius: 8px;
    padding: 6px;
}

QMenu::item { padding: 6px 24px; border-radius: 4px; }
QMenu::item:selected { background-color: #0078d4; color: #ffffff; }

QToolTip {
    background-color: #ffffff;
    color: #1a1a1a;
    border: 1px solid #d1d1d1;
    border-radius: 4px;
    padding: 6px;
}

/* --- QSPINBOX (SILVER ELEGANT LIGHT THEME) --- */
QSpinBox, QDoubleSpinBox {
    background-color: #ffffff;
    border: 1px solid #dcdcdc;
    border-bottom: 2px solid #a0a0a0;
    border-radius: 5px;
    color: #1a1a1a;
    padding: 5px 28px 5px 10px;
    selection-background-color: #e5e5e5;
    selection-color: #000000;
}

QSpinBox:hover, QDoubleSpinBox:hover {
    background-color: #fafafa;
    border-color: #c0c0c0;
    border-bottom-color: #666666;
}

QSpinBox:focus, QDoubleSpinBox:focus {
    background-color: #ffffff;
    border-bottom: 2px solid #0078d4;
}

QSpinBox::up-button, QDoubleSpinBox::up-button {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 20px;
    height: 11px;
    background-color: #f3f3f3;
    border-top-right-radius: 4px;
    border: none;
    margin-right: 2px;
    margin-top: 2px;
}

QSpinBox::down-button, QDoubleSpinBox::down-button {
    subcontrol-origin: padding;
    subcontrol-position: bottom right;
    width: 20px;
    height: 11px;
    background-color: #f3f3f3;
    border-bottom-right-radius: 4px;
    border: none;
    margin-right: 2px;
    margin-bottom: 2px;
}

QSpinBox::up-button:hover, QDoubleSpinBox::up-button:hover,
QSpinBox::down-button:hover, QDoubleSpinBox::down-button:hover {
    background-color: #e2e8f0;
}

QSpinBox::up-button:pressed, QDoubleSpinBox::up-button:pressed,
QSpinBox::down-button:pressed, QDoubleSpinBox::down-button:pressed {
    background-color: #cbd5e1;
}

QSpinBox::up-arrow, QDoubleSpinBox::up-arrow {
    width: 0px;
    height: 0px;
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    border-bottom: 5px solid #475569;
}

QSpinBox::down-arrow, QDoubleSpinBox::down-arrow {
    width: 0px;
    height: 0px;
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    border-top: 5px solid #475569;
}

QSpinBox::up-button:hover QSpinBox::up-arrow,
QDoubleSpinBox::up-button:hover QDoubleSpinBox::up-arrow,
QSpinBox::down-button:hover QSpinBox::down-arrow,
QDoubleSpinBox::down-button:hover QDoubleSpinBox::down-arrow {
    border-bottom-color: #0f172a;
    border-top-color: #0f172a;
}

/* =========================================================================
   QLABEL STYLES - WINDOWS 11 FLUENT LIGHT THEME
   ========================================================================= */

QLabel {
    color: #1a1a1a;
    font-family: "Segoe UI";
    font-size: 9.5pt;
    background-color: transparent;
    border: none;
    padding: 0px;
    margin: 0px;
}

QLabel:disabled {
    color: #8e8e8e;
}

#lblHeaderTitle, #lblRamLoadVal, #lblAppBanner {
    font-size: 16pt;
    font-weight: bold;
    color: #000000;
}

#lblStandbyVal {
    font-size: 10pt;
    color: #555555;
}

QLabel[heading="true"] {
    font-size: 12pt;
    font-weight: bold;
    color: #000000;
}

QLabel[subtitle="true"] {
    font-size: 9pt;
    color: #606060;
}

QLabel[accent="true"] {
    color: #0078d4;
    font-weight: bold;
}

QLabel[status="success"] {
    color: #107c41;
    font-weight: bold;
}

QLabel[status="warning"] {
    color: #d97706;
    font-weight: bold;
}

QLabel[status="error"] {
    color: #d13438;
    font-weight: bold;
}

QLabel[badge="true"] {
    background-color: #f8f8f8;
    color: #0078d4;
    border: 1px solid #e5e5e5;
    border-radius: 4px;
    padding: 2px 8px;
    font-size: 8.5pt;
    font-weight: bold;
}

QLabel[interactive="true"]:hover {
    color: #0078d4;
}
